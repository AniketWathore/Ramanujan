{
	"name": "@ramanujan/bridge",
	"version": "0.4.0",
	"description": "Typed bridge to the Ramanujan Python math engine (ramanujan-engine)",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist", "README.md"],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run"
	},
	"keywords": ["ramanujan", "bridge"],
	"author": "Ramanujan",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "22.19.19",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
