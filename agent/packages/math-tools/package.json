{
	"name": "@ramanujan/math-tools",
	"version": "0.4.0",
	"description": "Math verification tools for the Ramanujan TS agent (pi extension)",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist", "README.md"],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run"
	},
	"keywords": ["ramanujan", "math", "pi-extension"],
	"author": "Ramanujan",
	"license": "MIT",
	"dependencies": {
		"@ramanujan/bridge": "0.4.0",
		"@ramanujan/config": "0.4.0",
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
